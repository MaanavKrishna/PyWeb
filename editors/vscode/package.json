{
  "name": "pyweb",
  "displayName": "PyWeb",
  "description": "PyWeb (.pyweb) support: highlighting, errors as you type, hover that shows what runs in the browser or on the server, completion for Models, queries and forms, N+1 and migration warnings with a one-click fix, go to definition, tag closing, Emmet, and commands to create and run apps.",
  "version": "0.5.0",
  "publisher": "maanavkrishna",
  "license": "MIT",
  "homepage": "https://maanavkrishna.github.io/PyWeb/",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaanavKrishna/PyWeb",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/MaanavKrishna/PyWeb/issues"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "pyweb",
    "python",
    "web",
    "full-stack",
    "html",
    "mcp"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "pyweb",
        "aliases": [
          "PyWeb",
          "pyweb"
        ],
        "extensions": [
          ".pyweb"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/file.svg",
          "dark": "./images/file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "pyweb",
        "scopeName": "source.pyweb",
        "path": "./syntaxes/pyweb.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.expression.pyweb": "python"
        }
      }
    ],
    "snippets": [
      {
        "language": "pyweb",
        "path": "./snippets/pyweb.json"
      }
    ],
    "commands": [
      {
        "command": "pyweb.runDev",
        "title": "Run App (dev server)",
        "category": "PyWeb",
        "icon": "$(play)"
      },
      {
        "command": "pyweb.newApp",
        "title": "New App...",
        "category": "PyWeb"
      },
      {
        "command": "pyweb.check",
        "title": "Check App",
        "category": "PyWeb"
      },
      {
        "command": "pyweb.makeMigration",
        "title": "Create Migration from Model Changes",
        "category": "PyWeb"
      },
      {
        "command": "pyweb.upgradeDatabase",
        "title": "Apply Migrations (dev database)",
        "category": "PyWeb"
      },
      {
        "command": "pyweb.addPackage",
        "title": "Add npm Package...",
        "category": "PyWeb"
      },
      {
        "command": "pyweb.installPyweb",
        "title": "Install or Update PyWeb",
        "category": "PyWeb"
      },
      {
        "command": "pyweb.setUpMcp",
        "title": "Set Up AI Assistant (MCP)",
        "category": "PyWeb"
      },
      {
        "command": "pyweb.restartServer",
        "title": "Restart Language Server",
        "category": "PyWeb"
      }
    ],
    "configuration": {
      "title": "PyWeb",
      "properties": {
        "pyweb.server.command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Command that starts the language server, e.g. `[\"/path/to/venv/bin/pyweb\", \"lsp\"]`. Empty: the first that has PyWeb 0.3+ of the Python extension's interpreter, `pyweb` on `PATH`, `python3` and `python`. When it ends in `lsp`, the rest is also used for the Run, New App and other commands."
        },
        "pyweb.dev.port": {
          "type": "integer",
          "default": 8000,
          "minimum": 1,
          "maximum": 65535,
          "description": "Port for PyWeb: Run App."
        },
        "pyweb.dev.openBrowser": {
          "type": "boolean",
          "default": false,
          "description": "Open the app in the browser after PyWeb: Run App starts it."
        },
        "pyweb.autoCloseTags": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Add the closing tag when you type the `>` of an opening tag in markup."
        }
      }
    },
    "menus": {
      "editor/title/run": [
        {
          "command": "pyweb.runDev",
          "when": "resourceLangId == pyweb",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "pyweb.runDev",
          "when": "resourceExtname == .pyweb",
          "group": "pyweb@1"
        },
        {
          "command": "pyweb.check",
          "when": "resourceExtname == .pyweb",
          "group": "pyweb@2"
        }
      ],
      "commandPalette": [
        {
          "command": "pyweb.runDev",
          "when": "resourceLangId == pyweb || workspaceFolderCount > 0"
        },
        {
          "command": "pyweb.check",
          "when": "resourceLangId == pyweb || workspaceFolderCount > 0"
        },
        {
          "command": "pyweb.addPackage",
          "when": "resourceLangId == pyweb || workspaceFolderCount > 0"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pyweb.runDev",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "editorLangId == pyweb"
      }
    ],
    "configurationDefaults": {
      "emmet.includeLanguages": {
        "pyweb": "html"
      },
      "[pyweb]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      }
    }
  },
  "scripts": {
    "test": "node test/grammar.test.js && node test/extension.test.js",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  }
}
