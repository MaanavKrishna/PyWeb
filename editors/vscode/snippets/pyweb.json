{
  "Page": {
    "prefix": "page",
    "description": "A page at a route",
    "body": [
      "@app.page(\"${1:/}\")",
      "def ${2:Home}():",
      "    ${3:count = 0}",
      "",
      "    <main>",
      "        $0",
      "    </main>"
    ]
  },
  "Component": {
    "prefix": "component",
    "description": "A component with props and children",
    "body": [
      "def ${1:Card}(${2:title}, children=None):",
      "    <section>",
      "        <h2>{${2:title}}</h2>",
      "        {children}",
      "    </section>"
    ]
  },
  "Server function": {
    "prefix": "server",
    "description": "A function that runs on the server and is called from the browser over RPC",
    "body": [
      "@server",
      "def ${1:save}(${2:item: str}) -> ${3:None}:",
      "    $0"
    ]
  },
  "Event handler": {
    "prefix": "handler",
    "description": "An event handler (runs in the browser)",
    "body": [
      "def ${1:on_click}():",
      "    $0"
    ]
  },
  "For loop in markup": {
    "prefix": "for",
    "description": "Render a list",
    "body": [
      "for ${1:item} in ${2:items}:",
      "    <li>{${1:item}}</li>"
    ]
  },
  "Live updates": {
    "prefix": "live",
    "description": "Subscribe a page to a channel (publish() from server code)",
    "body": [
      "feed = channel(\"${1:updates}\")",
      "",
      "def ${2:received}(message):",
      "    $0",
      "",
      "def on_mount():",
      "    subscribe(feed, ${2:received})"
    ]
  },
  "New app": {
    "prefix": "pyweb",
    "description": "A complete one-page app",
    "body": [
      "from pyweb import App, server",
      "",
      "app = App(title=\"${1:My app}\")",
      "",
      "",
      "@app.page(\"/\")",
      "def Home():",
      "    count = 0",
      "",
      "    def increment():",
      "        count += 1",
      "",
      "    <main>",
      "        <h1>${1:My app}</h1>",
      "        <button onclick={increment}>Clicked {count} times</button>",
      "    </main>",
      ""
    ]
  },
  "Layout": {
    "prefix": "layout",
    "description": "A layout around every page (header, nav, footer)",
    "body": [
      "@app.layout",
      "def ${1:Shell}(children):",
      "    <header>",
      "        <nav>",
      "            <a href=\"/\">${2:Home}</a>",
      "        </nav>",
      "    </header>",
      "    <main>{children}</main>$0"
    ]
  },
  "Error page": {
    "prefix": "error",
    "description": "A custom 404 or 500 page",
    "body": [
      "@app.error(${1:404})",
      "def ${2:Missing}(path):",
      "    <h1>${3:Nothing at {path\\}}</h1>",
      "    <a href=\"/\">Home</a>$0"
    ]
  },
  "Streaming server function": {
    "prefix": "stream",
    "description": "A server function that streams values to the browser as they're produced",
    "body": [
      "@server",
      "def ${1:reply}(${2:prompt: str}):",
      "    for ${3:piece} in ${4:pieces}:",
      "        yield ${3:piece}$0"
    ]
  },
  "Live query": {
    "prefix": "livequery",
    "description": "Rows that update in every browser when the table changes",
    "body": [
      "${1:rows} = live(db, \"${2:select * from ${3:todos} order by id}\")$0"
    ]
  },
  "npm package": {
    "prefix": "npm",
    "description": "Use an npm package in browser code (install it with: pyweb add NAME)",
    "body": [
      "${1:Chart} = npm(\"${2:chart.js/auto}\")$0"
    ]
  },
  "Mount hook": {
    "prefix": "mount",
    "description": "Run browser code when the page appears, and clean up when it goes",
    "body": [
      "def on_mount():",
      "    ${1:pass}",
      "",
      "def on_unmount():",
      "    ${2:pass}$0"
    ]
  },
  "Model": {
    "prefix": "model",
    "description": "A database table (migrate with pyweb db diff)",
    "body": [
      "class ${1:Post}(Model):",
      "    ${2:title}: str = Field(min=${3:1}, max=${4:120})",
      "    $0"
    ]
  },
  "Relation": {
    "prefix": "fk",
    "description": "A foreign key to another Model",
    "body": [
      "${1:author}: ${2:User} = Field(readonly=True)$0"
    ]
  },
  "Form page": {
    "prefix": "formpage",
    "description": "A page with a <Form> that saves a Model",
    "body": [
      "@server(login=True)",
      "def save_${1:post}(${1:post}: ${2:Post}):",
      "    ${1:post}.save()",
      "    return ${1:post}",
      "",
      "",
      "@app.page(\"/${1:post}s/new\", login=True)",
      "def New${2:Post}():",
      "    <Form action={save_${1:post}} redirect=\"/${1:post}s/{id}\">",
      "        <Input name=\"${3:title}\" />",
      "        <Submit>Save</Submit>",
      "    </Form>$0"
    ]
  },
  "Live list page": {
    "prefix": "livepage",
    "description": "A page whose rows update by themselves",
    "body": [
      "@app.page(\"/${1:posts}\")",
      "def ${2:Posts}():",
      "    rows = ${3:Post}.query().order(\"-id\").limit(${4:50}).live()",
      "    <ul>",
      "        for row in rows:",
      "            <li>{row[\"${5:title}\"]}</li>",
      "    </ul>$0"
    ]
  },
  "Background job": {
    "prefix": "job",
    "description": "A durable background job",
    "body": [
      "@app.job(retries=${1:5})",
      "def ${2:send_receipt}(${3:order_id}: int):",
      "    ${0:pass}",
      "",
      "# ${2:send_receipt}.enqueue(order.id)  # runs after the request's writes commit"
    ]
  },
  "Schedule": {
    "prefix": "cron",
    "description": "Run a function on a schedule",
    "body": [
      "@app.cron(\"${1:0 3 * * *}\", tz=\"${2:UTC}\")",
      "def ${3:nightly}():",
      "    ${0:pass}"
    ]
  },
  "Row policy": {
    "prefix": "policy",
    "description": "Each user sees and changes only their rows",
    "body": [
      "${1:Note}.policy(read=lambda user: ${1:Note}.owner_id == (user.id if user else -1),",
      "            write=lambda user, row: user is not None and row.owner_id == user.id)$0"
    ]
  },
  "Auth": {
    "prefix": "useauth",
    "description": "Accounts, sign-in pages and /admin",
    "body": [
      "auth = app.use_auth(${1:providers=[\"github\"]})$0"
    ]
  }
}
