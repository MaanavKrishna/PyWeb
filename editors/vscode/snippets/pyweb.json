{
  "Page": {
    "prefix": "page",
    "description": "A page at a route",
    "body": [
      "@app.page(\"${1:/}\")",
      "def ${2:Home}():",
      "    ${3:count = 0}",
      "",
      "    <main>",
      "        $0",
      "    </main>"
    ]
  },
  "Component": {
    "prefix": "component",
    "description": "A component with props and children",
    "body": [
      "def ${1:Card}(${2:title}, children=None):",
      "    <section>",
      "        <h2>{${2:title}}</h2>",
      "        {children}",
      "    </section>"
    ]
  },
  "Server function": {
    "prefix": "server",
    "description": "A function that runs on the server and is called from the browser over RPC",
    "body": [
      "@server",
      "def ${1:save}(${2:item: str}) -> ${3:None}:",
      "    $0"
    ]
  },
  "Event handler": {
    "prefix": "handler",
    "description": "An event handler (runs in the browser)",
    "body": [
      "def ${1:on_click}():",
      "    $0"
    ]
  },
  "For loop in markup": {
    "prefix": "for",
    "description": "Render a list",
    "body": [
      "for ${1:item} in ${2:items}:",
      "    <li>{${1:item}}</li>"
    ]
  },
  "Live updates": {
    "prefix": "live",
    "description": "Subscribe a page to a channel (publish() from server code)",
    "body": [
      "feed = channel(\"${1:updates}\")",
      "",
      "def ${2:received}(message):",
      "    $0",
      "",
      "def on_mount():",
      "    subscribe(feed, ${2:received})"
    ]
  },
  "New app": {
    "prefix": "pyweb",
    "description": "A complete one-page app",
    "body": [
      "from pyweb import App, server",
      "",
      "app = App(title=\"${1:My app}\")",
      "",
      "",
      "@app.page(\"/\")",
      "def Home():",
      "    count = 0",
      "",
      "    def increment():",
      "        count += 1",
      "",
      "    <main>",
      "        <h1>${1:My app}</h1>",
      "        <button onclick={increment}>Clicked {count} times</button>",
      "    </main>",
      ""
    ]
  },
  "Layout": {
    "prefix": "layout",
    "description": "A layout around every page (header, nav, footer)",
    "body": [
      "@app.layout",
      "def ${1:Shell}(children):",
      "    <header>",
      "        <nav>",
      "            <a href=\"/\">${2:Home}</a>",
      "        </nav>",
      "    </header>",
      "    <main>{children}</main>$0"
    ]
  },
  "Error page": {
    "prefix": "error",
    "description": "A custom 404 or 500 page",
    "body": [
      "@app.error(${1:404})",
      "def ${2:Missing}(path):",
      "    <h1>${3:Nothing at {path\\}}</h1>",
      "    <a href=\"/\">Home</a>$0"
    ]
  },
  "Streaming server function": {
    "prefix": "stream",
    "description": "A server function that streams values to the browser as they're produced",
    "body": [
      "@server",
      "def ${1:reply}(${2:prompt: str}):",
      "    for ${3:piece} in ${4:pieces}:",
      "        yield ${3:piece}$0"
    ]
  },
  "Live query": {
    "prefix": "livequery",
    "description": "Rows that update in every browser when the table changes",
    "body": [
      "${1:rows} = live(db, \"${2:select * from ${3:todos} order by id}\")$0"
    ]
  },
  "npm package": {
    "prefix": "npm",
    "description": "Use an npm package in browser code (install it with: pyweb add NAME)",
    "body": [
      "${1:Chart} = npm(\"${2:chart.js/auto}\")$0"
    ]
  },
  "Mount hook": {
    "prefix": "mount",
    "description": "Run browser code when the page appears, and clean up when it goes",
    "body": [
      "def on_mount():",
      "    ${1:pass}",
      "",
      "def on_unmount():",
      "    ${2:pass}$0"
    ]
  }
}
