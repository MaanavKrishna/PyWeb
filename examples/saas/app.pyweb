"""Teamboard: a small SaaS. Accounts, projects and tasks that update live,
forms with validation, a background job, a daily email and an admin.

Run it:      pyweb dev app.pyweb        (sign up; the confirmation link is printed in the terminal)
Test it:     pytest
Ship it:     pyweb deploy compose        (or fly, render, railway, k8s)
"""

import logging

from pyweb import App, Field, Form, Input, Model, Submit, Textarea, server
from pyweb.authkit import User
from pyweb.telemetry import span
from pyweb.ui import (Badge, Button, Card, CardContent, Checkbox, Dialog, DialogContent, DialogDescription,
                      DialogHeader, DialogTitle, DialogTrigger, DropdownMenu, DropdownMenuContent, DropdownMenuTrigger,
                      MenuItem, MenuLabel, MenuSeparator, Sidebar, SidebarContent, SidebarFooter, SidebarGroup,
                      SidebarHeader, SidebarInset, SidebarMenu, SidebarMenuButton, SidebarMenuItem, SidebarProvider,
                      SidebarTrigger, Theme, toast)

app = App(title="Teamboard", database="sqlite:///app.db", stylesheets=["/static/app.css"],
          theme=Theme.preset("zinc"))
auth = app.use_auth()
log = logging.getLogger("teamboard")


# ------------------------------------------------------------------ data

class Project(Model):
    name: str = Field(min=2, max=60)
    about: str = Field(default="", max=500)
    owner: User = Field(readonly=True)


class Task(Model):
    title: str = Field(min=1, max=120)
    done: bool = False
    project: Project = Field(readonly=True)
    owner: User = Field(readonly=True)


# Each person sees and changes only their own rows, on every query and save made for a request.
def mine(model):
    return lambda user: model.owner_id == (user.id if user else -1)


Project.policy(read=mine(Project), write=lambda user, row: user is not None and row.owner_id == user.id)
Task.policy(read=mine(Task), write=lambda user, row: user is not None and row.owner_id == user.id)


# ------------------------------------------------------------------ actions

@server(login=True)
def create_project(project: Project):
    project.owner = auth.user()
    project.save()
    welcome_tasks.enqueue(project.id)              # runs in the background, after this commits
    toast("Project created", "Its starter checklist is on the way.", tone="success")
    return project


@server(login=True)
def add_task(project_id: int, title: str = Field(min=1, max=120)):
    project = Project.get_or_404(project_id)       # someone else's project: 404, thanks to the policy
    return Task.create(title=title, project=project, owner_id=project.owner_id)


@server(login=True)
def toggle(task_id: int) -> bool:
    task = Task.get_or_404(task_id)
    task.done = not task.done
    task.save()
    return task.done


@server(login=True)
def remove(task_id: int) -> None:
    Task.get_or_404(task_id).delete()
    toast("Task deleted")


# ------------------------------------------------------------------ background work

@app.job(retries=3)
def welcome_tasks(project_id: int):
    """A new project starts with a checklist (a job: it could just as well call an API)."""
    project = Project.get(project_id)
    with span("seed checklist", project=project_id):
        for title in ("Invite your team", "Write the first task", "Ship something small"):
            Task.get_or_create(title=title, project=project, defaults={"owner_id": project.owner_id})


@app.cron("0 8 * * 1-5", tz="UTC")
def morning_digest():
    """Weekday mornings: email everyone their open tasks."""
    from pyweb import mail
    for user in User.query():
        open_tasks = Task.where(owner=user, done=False).order("id").limit(20).pluck("title")
        if open_tasks:
            mail.send(user.email, f"{len(open_tasks)} open tasks",
                      "Good morning! Still open:\n\n" + "\n".join(f"- {t}" for t in open_tasks))
            log.info("sent digest", extra={"tasks": len(open_tasks)})


# ------------------------------------------------------------------ pages

def sidebar_projects():
    """The newest projects with their open task counts, for the sidebar (two queries)."""
    counts = {}
    for project_id in Task.where(done=False).pluck("project_id"):
        counts[project_id] = counts.get(project_id, 0) + 1
    return [{"id": p.id, "name": p.name, "open": counts.get(p.id)} for p in Project.query().order("-id").limit(12)]


@app.layout
def Shell(children):
    user = auth.user()
    projects = sidebar_projects() if user else []
    <SidebarProvider>
        if user:
            <Sidebar label="Teamboard">
                <SidebarHeader><a class="brand" href="/projects">Teamboard</a></SidebarHeader>
                <SidebarContent>
                    <SidebarGroup>
                        <SidebarMenu>
                            <SidebarMenuItem>
                                <SidebarMenuButton href="/projects" icon="▦">All projects</SidebarMenuButton>
                            </SidebarMenuItem>
                        </SidebarMenu>
                    </SidebarGroup>
                    <SidebarGroup label="Projects">
                        <SidebarMenu>
                            for p in projects:
                                <SidebarMenuItem>
                                    <SidebarMenuButton href={f"/projects/{p['id']}"} icon="#" badge={p["open"]}>
                                        {p["name"]}
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                        </SidebarMenu>
                    </SidebarGroup>
                </SidebarContent>
                <SidebarFooter>
                    <DropdownMenu side="top">
                        <DropdownMenuTrigger variant="ghost" class_="user-button">{user.name or user.email}</DropdownMenuTrigger>
                        <DropdownMenuContent>
                            <MenuLabel>{user.email}</MenuLabel>
                            <MenuItem href="/account">Account</MenuItem>
                            if "admin" in (user.roles or []):
                                <MenuItem href="/admin">Admin</MenuItem>
                            <MenuSeparator />
                            <MenuItem href="/logout">Sign out</MenuItem>
                        </DropdownMenuContent>
                    </DropdownMenu>
                </SidebarFooter>
            </Sidebar>
        <SidebarInset>
            <header class="topbar">
                if user:
                    <SidebarTrigger />
                else:
                    <a class="brand" href="/">Teamboard</a>
                    <span class="spacer"></span>
                    <Button href="/login" variant="ghost">Sign in</Button>
                    <Button href="/signup">Sign up</Button>
            </header>
            {children}
        </SidebarInset>
    </SidebarProvider>


@app.page("/")
def Home():
    <div class="page hero" animate="fade-up">
        <Badge variant="secondary">Live updates · background jobs · admin</Badge>
        <h1>Plan the week with your team</h1>
        <p class="muted">Projects and tasks that update live in every open tab.</p>
        <div class="row">
            <Button href="/signup" size="lg">Create an account</Button>
            <Button href="/projects" size="lg" variant="outline">Open your projects</Button>
        </div>
    </div>


@app.page("/projects", login=True, title="Projects")
def Projects():
    projects = Project.query().order("-id").live()
    <div class="page">
        <div class="page-head">
            <h1>Projects</h1>
            <Dialog>
                <DialogTrigger id="new-project">New project</DialogTrigger>
                <DialogContent>
                    <DialogHeader>
                        <DialogTitle>New project</DialogTitle>
                        <DialogDescription>It starts with a short checklist, made by a background job.</DialogDescription>
                    </DialogHeader>
                    <Form action={create_project} redirect="/projects/{id}">
                        <Input name="name" placeholder="Website relaunch" />
                        <Textarea name="about" rows="2" placeholder="What is it about? (optional)" />
                        <Submit>Create project</Submit>
                    </Form>
                </DialogContent>
            </Dialog>
        </div>
        <ul id="projects" class="grid">
            for p in projects:
                <li animate="fade-up" layout>
                    <a class="pw-card project" href={f"/projects/{p['id']}"}>
                        <b>{p["name"]}</b>
                        <span class="muted">{p["about"] or "No description"}</span>
                    </a>
                </li>
        </ul>
        if not projects:
            <Card class_="empty-state" animate="fade">
                <CardContent>
                    <p><b>No projects yet</b></p>
                    <p class="muted">Start one with New project: it comes with a checklist.</p>
                </CardContent>
            </Card>
    </div>


@app.page("/projects/{project_id}", login=True, title="Project")
def ProjectPage(project_id: int):
    project = Project.get_or_404(project_id)
    tasks = Task.where(project_id=project.id).order("done", "id").live()
    left = len([t for t in tasks if not t["done"]])
    <div class="page">
        <p><Button href="/projects" variant="ghost" size="sm">← Projects</Button></p>
        <div class="page-head">
            <h1>{project.name}</h1>
            <Badge variant="secondary" id="left">{left} open</Badge>
        </div>
        if project.about:
            <p class="muted">{project.about}</p>
        <Card>
            <CardContent>
                <Form action={add_task} values={{"project_id": project.id}}>
                    <Input name="project_id" type="hidden" />
                    <Input name="title" label="" placeholder="Add a task" />
                    <Submit>Add</Submit>
                </Form>
                <ul id="tasks">
                    for t in tasks:
                        <li class={{"done": t["done"]}} initial={{"opacity": 0, "y": -6}} animate={{"opacity": 1, "y": 0}}
                            exit={{"opacity": 0, "x": 24}} layout>
                            <Checkbox checked={t["done"]} onchange={lambda: toggle(t["id"])} aria-label={"Done: " + t["title"]} />
                            <span>{t["title"]}</span>
                            <Button variant="ghost" size="icon" class_="remove" onclick={lambda: remove(t["id"])}
                                    aria-label="Remove">×</Button>
                        </li>
                </ul>
                if not tasks:
                    <p class="empty">No tasks yet. Add the first one above.</p>
            </CardContent>
        </Card>
    </div>
