"""Accounts: password hashing, signed-cookie sessions, protected pages."""

from pyweb import App, RPCError, redirect, server, session
from pyweb.auth import hash_password, verify_password
from pyweb.ui import Badge, Button, Card, CardContent, CardDescription, CardFooter, CardHeader

app = App(title="Accounts", stylesheets=["/static/app.css"])

# In-memory user store keeps the example self-contained; use a database
# table (see examples/blog) in a real app.
USERS = {}


@server
def register(email: str, name: str, password: str) -> bool:
    email = email.strip().lower()
    if "@" not in email or len(password) < 8:
        raise RPCError("validation_error", "Use a valid email and a password of 8+ characters.")
    if email in USERS:
        raise RPCError("conflict", "That email is already registered.")
    USERS[email] = {"name": name.strip() or email, "hash": hash_password(password)}
    session.login(email, name=USERS[email]["name"])
    return True


@server
def login(email: str, password: str) -> bool:
    user = USERS.get(email.strip().lower())
    if user is None or not verify_password(password, user["hash"]):
        return False
    session.login(email.strip().lower(), name=user["name"])
    return True


@server
def logout() -> None:
    session.logout()


@app.page("/", title="Sign in")
def Login():
    if session.user():
        return redirect("/account")
    email = ""
    password = ""
    error = ""

    def submit():
        if login(email, password):
            window.location.href = "/account"
        else:
            error = "Wrong email or password."

    <main class="narrow">
        <Card animate="fade-up">
            <CardHeader>
                <h1 data-part="title">Sign in</h1>
                <CardDescription>Welcome back.</CardDescription>
            </CardHeader>
            <CardContent>
                <form class="stack" onsubmit={submit}>
                    <label class="pw-field">Email <input id="email" class="pw-control" type="email" bind={email} /></label>
                    <label class="pw-field">Password
                        <input id="password" class="pw-control" type="password" bind={password} />
                    </label>
                    <p class="error" id="error" role="alert">{error}</p>
                    <Button id="login" type="submit">Sign in</Button>
                </form>
            </CardContent>
            <CardFooter>
                <p class="muted">No account? <a href="/register">Create one</a>.</p>
            </CardFooter>
        </Card>
    </main>


@app.page("/register", title="Create account")
def Register():
    email = ""
    name = ""
    password = ""
    error = ""

    def submit():
        try:
            register(email, name, password)
            window.location.href = "/account"
        except RPCError as e:
            error = str(e)

    <main class="narrow">
        <Card animate="fade-up">
            <CardHeader>
                <h1 data-part="title">Create account</h1>
                <CardDescription>It takes ten seconds.</CardDescription>
            </CardHeader>
            <CardContent>
                <form class="stack" onsubmit={submit}>
                    <label class="pw-field">Name <input id="name" class="pw-control" bind={name} /></label>
                    <label class="pw-field">Email <input id="email" class="pw-control" type="email" bind={email} /></label>
                    <label class="pw-field">Password
                        <input id="password" class="pw-control" type="password" bind={password}
                               placeholder="8+ characters" />
                    </label>
                    <p class="error" id="error" role="alert">{error}</p>
                    <Button id="register" type="submit">Create account</Button>
                </form>
            </CardContent>
        </Card>
    </main>


@app.page("/account", title="Your account")
def Account():
    user = session.user()
    if not user:
        return redirect("/")
    name = user["name"]
    email = user["sub"]

    def sign_out():
        logout()
        window.location.href = "/"

    <main class="narrow">
        <Card animate="fade-up">
            <CardHeader>
                <h1 data-part="title">Hello, {name}</h1>
                <CardDescription>Signed in as {email} <Badge tone="success">active session</Badge></CardDescription>
            </CardHeader>
            <CardFooter>
                <Button id="logout" variant="outline" onclick={sign_out}>Sign out</Button>
            </CardFooter>
        </Card>
    </main>
