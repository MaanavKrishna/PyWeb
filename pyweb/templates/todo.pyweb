"""Todo list: client-side state, a component, computed values, filters, the UI kit and motion."""

from pyweb import App, component
from pyweb.ui import Button, Card, CardContent, CardDescription, CardHeader, Checkbox, ToggleGroup, ToggleGroupItem

app = App(title="Todos", stylesheets=["/static/app.css"])

FILTERS = ["all", "active", "done"]


@component
def TodoItem(todo, on_toggle, on_remove):
    <li class={{"done": todo["done"]}} initial={{"opacity": 0, "y": -8}} animate={{"opacity": 1, "y": 0}}
        exit={{"opacity": 0, "x": 24}} layout>
        <Checkbox checked={todo["done"]} onchange={on_toggle} aria-label={"Done: " + todo["title"]} />
        <span>{todo["title"]}</span>
        <Button variant="ghost" size="icon" class_="remove" onclick={on_remove} aria-label="Remove">×</Button>
    </li>


@app.page("/")
def Home():
    todos = []
    draft = ""
    show = "all"
    next_id = 1
    visible = [t for t in todos if show == "all" or (show == "done") == t["done"]]
    remaining = len([t for t in todos if not t["done"]])

    def add():
        title = draft.strip()
        if not title:
            return
        todos.append({"id": next_id, "title": title, "done": False})
        next_id += 1
        draft = ""

    def toggle(todo_id):
        for i, t in enumerate(todos):
            if t["id"] == todo_id:
                todos[i]["done"] = not t["done"]

    def remove(todo_id):
        todos = [t for t in todos if t["id"] != todo_id]

    def set_filter(e):
        show = e.detail["value"] or show

    def clear_done():
        todos = [t for t in todos if not t["done"]]

    <main>
        <Card>
            <CardHeader>
                <h1 data-part="title">Todos</h1>
                <CardDescription>Everything here runs in your browser.</CardDescription>
            </CardHeader>
            <CardContent>
                <form class="add" onsubmit={add}>
                    <input id="new" class="pw-control" bind={draft} placeholder="What needs doing?"
                           aria-label="New todo" autofocus />
                    <Button id="add" type="submit" disabled={not draft.strip()}>Add</Button>
                </form>
                <ul id="list">
                    for todo in visible:
                        <TodoItem
                            todo={todo}
                            on_toggle={lambda: toggle(todo["id"])}
                            on_remove={lambda: remove(todo["id"])} />
                </ul>
                if todos:
                    <footer>
                        <span id="left">{remaining} {"item" if remaining == 1 else "items"} left</span>
                        <ToggleGroup value={show} onvaluechange={set_filter} size="sm" label="Show">
                            for name in FILTERS:
                                <ToggleGroupItem value={name}>{name}</ToggleGroupItem>
                        </ToggleGroup>
                        <Button id="clear" variant="ghost" size="sm" onclick={clear_done}>Clear done</Button>
                    </footer>
                else:
                    <p class="empty" animate="fade">Nothing to do yet. Add something above.</p>
            </CardContent>
        </Card>
    </main>
