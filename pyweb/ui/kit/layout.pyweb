"""Layout and navigation: scroll area, resizable panels, sidebar, navigation menu, breadcrumb,
pagination.

    <SidebarProvider>
        <Sidebar>
            <SidebarHeader>Acme</SidebarHeader>
            <SidebarContent>
                <SidebarGroup label="Workspace">
                    <SidebarMenu>
                        <SidebarMenuItem><SidebarMenuButton href="/" active={True} icon="⌂">Home</SidebarMenuButton></SidebarMenuItem>
                    </SidebarMenu>
                </SidebarGroup>
            </SidebarContent>
        </Sidebar>
        <SidebarInset><SidebarTrigger /> ...page...</SidebarInset>
    </SidebarProvider>

    <ResizablePanelGroup direction="horizontal" save="editor">
        <ResizablePanel size={30} min={15}>Files</ResizablePanel>
        <ResizableHandle grip={True} />
        <ResizablePanel size={70}>Editor</ResizablePanel>
    </ResizablePanelGroup>

    <Pagination page={page} pages={12} href="?page=" />
"""


def _num(x):
    return str(int(x)) if x == int(x) else str(round(x, 2))


def _page_list(page, pages, siblings):
    """1-based page numbers to show, with 0 where an ellipsis goes: 1 … 4 5 6 … 12."""
    if pages <= 5 + 2 * siblings:
        return list(range(1, pages + 1))
    lo = max(2, page - siblings)
    hi = min(pages - 1, page + siblings)
    if lo <= 3:
        lo, hi = 2, 3 + 2 * siblings
    if hi >= pages - 2:
        lo, hi = pages - 2 - 2 * siblings, pages - 1
    out = [1]
    if lo > 2:
        out.append(0)
    out.extend(range(lo, hi + 1))
    if hi < pages - 1:
        out.append(0)
    out.append(pages)
    return out


def ScrollArea(height=None, max_height=None, orientation="vertical", label=None, children=None, **attrs):
    style = {"height": height, "max-height": max_height}
    <div class="pw-scroll-area" data-part="scroll-area" data-orientation={orientation} tabindex="0"
         role={"region" if label else None} aria-label={label} style={style} {**attrs}>{children}</div>


def ResizablePanelGroup(direction="horizontal", save=None, children=None, **attrs):
    <div class="pw-resizable" data-pw-ui="resizable" data-part="root" data-direction={direction} data-save={save}
         {**attrs}>{children}</div>


def ResizablePanel(size=None, min=None, max=None, collapsible=False, children=None, **attrs):
    style = {"flex": _num(size) + " 1 0px"} if size is not None else None
    <div class="pw-resizable-panel" data-part="panel" data-size={size} data-min={min} data-max={max}
         data-collapsible={"" if collapsible else None} style={style} {**attrs}>{children}</div>


def ResizableHandle(grip=False, label="Resize", **attrs):
    <div class="pw-resizable-handle" data-part="handle" role="separator" tabindex="0" aria-label={label} {**attrs}>
        if grip:
            <span data-part="grip" aria-hidden="true"></span>
    </div>


# ------------------------------------------------------------------ sidebar

def SidebarProvider(collapsed=False, collapsible="icon", side="left", variant="sidebar", save=True, shortcut="b",
                    children=None, **attrs):
    <div class="pw-sidebar-layout" data-pw-ui="sidebar" data-part="root"
         data-state={"collapsed" if collapsed else "expanded"} data-collapsible={collapsible} data-side={side}
         data-variant={variant} data-save={None if save else "false"} data-shortcut={shortcut} {**attrs}>{children}</div>


def Sidebar(label="Sidebar", children=None, **attrs):
    <aside class="pw-sidebar" data-part="sidebar" aria-label={label} {**attrs}>
        <div data-part="inner">{children}</div>
    </aside>


def SidebarHeader(children=None, **attrs):
    <div class="pw-sidebar-header" data-part="header" {**attrs}>{children}</div>


def SidebarContent(children=None, **attrs):
    <div class="pw-sidebar-content" data-part="content" {**attrs}>{children}</div>


def SidebarFooter(children=None, **attrs):
    <div class="pw-sidebar-footer" data-part="footer" {**attrs}>{children}</div>


def SidebarGroup(label=None, children=None, **attrs):
    <div class="pw-sidebar-group" data-part="group" role={"group" if label else None} aria-label={label} {**attrs}>
        if label:
            <div class="pw-sidebar-group-label" data-part="group-label" aria-hidden="true">{label}</div>
        {children}
    </div>


def SidebarMenu(children=None, **attrs):
    <ul class="pw-sidebar-menu" data-part="menu" {**attrs}>{children}</ul>


def SidebarMenuItem(children=None, **attrs):
    <li class="pw-sidebar-item" data-part="menu-item" {**attrs}>{children}</li>


def SidebarMenuButton(href=None, active=False, icon=None, badge=None, children=None, **attrs):
    if href:
        <a class="pw-sidebar-button" data-part="menu-button" href={href} aria-current={"page" if active else None}
           data-active={"" if active else None} {**attrs}>
            if icon:
                <span data-part="icon" aria-hidden="true">{icon}</span>
            <span data-part="text">{children}</span>
            if badge:
                <span class="pw-sidebar-badge" data-part="badge">{badge}</span>
        </a>
    else:
        <button type="button" class="pw-sidebar-button" data-part="menu-button" data-active={"" if active else None}
                {**attrs}>
            if icon:
                <span data-part="icon" aria-hidden="true">{icon}</span>
            <span data-part="text">{children}</span>
            if badge:
                <span class="pw-sidebar-badge" data-part="badge">{badge}</span>
        </button>


def SidebarSeparator(**attrs):
    <div class="pw-separator" data-part="separator" data-orientation="horizontal" role="none" {**attrs}></div>


def SidebarTrigger(label="Toggle sidebar", **attrs):
    <button type="button" class="pw-button pw-sidebar-trigger" data-part="trigger" data-variant="ghost" data-size="icon"
            aria-label={label} {**attrs}>
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><rect x="1.5" y="2.5" width="13" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M6 2.5v11" stroke="currentColor" stroke-width="1.3"/></svg>
    </button>


def SidebarRail(label="Toggle sidebar", **attrs):
    <button type="button" class="pw-sidebar-rail" data-part="rail" tabindex="-1" aria-label={label} {**attrs}></button>


def SidebarInset(children=None, **attrs):
    <main class="pw-sidebar-inset" data-part="inset" {**attrs}>{children}</main>


# ------------------------------------------------------------------ navigation menu

def NavigationMenu(label="Main", children=None, **attrs):
    <nav class="pw-nav-menu" data-pw-ui="navigation-menu" data-part="root" data-state="closed" aria-label={label}
         {**attrs}>{children}</nav>


def NavigationMenuList(children=None, **attrs):
    <ul class="pw-nav-list" data-part="list" {**attrs}>{children}</ul>


def NavigationMenuItem(children=None, **attrs):
    <li class="pw-nav-item" data-part="item" {**attrs}>{children}</li>


def NavigationMenuTrigger(children=None, **attrs):
    <button type="button" class="pw-nav-trigger" data-part="trigger" data-state="closed" {**attrs}>
        {children}
        <svg class="pw-chevron" width="12" height="12" viewBox="0 0 15 15" aria-hidden="true"><path d="M4 6l3.5 3.5L11 6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
    </button>


def NavigationMenuContent(children=None, **attrs):
    <div class="pw-nav-content" data-part="content" data-state="closed" {**attrs}>{children}</div>


def NavigationMenuLink(href, active=False, description=None, children=None, **attrs):
    <a class="pw-nav-link" data-part="link" href={href} aria-current={"page" if active else None} {**attrs}>
        <span data-part="title">{children}</span>
        if description:
            <span data-part="description">{description}</span>
    </a>


# ------------------------------------------------------------------ breadcrumb

def Breadcrumb(label="Breadcrumb", children=None, **attrs):
    <nav class="pw-breadcrumb" data-pw-ui="breadcrumb" data-part="breadcrumb" aria-label={label} {**attrs}>
        <ol data-part="list">{children}</ol>
    </nav>


def BreadcrumbItem(children=None, **attrs):
    <li data-part="item" {**attrs}>{children}</li>


def BreadcrumbLink(href, children=None, **attrs):
    <a class="pw-breadcrumb-link" data-part="link" href={href} {**attrs}>{children}</a>


def BreadcrumbPage(children=None, **attrs):
    <span data-part="page" aria-current="page" {**attrs}>{children}</span>


def BreadcrumbSeparator(children=None, **attrs):
    <li data-part="separator" role="presentation" aria-hidden="true" {**attrs}>
        if children:
            {children}
        else:
            <svg width="12" height="12" viewBox="0 0 15 15"><path d="M6 3.5l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
    </li>


def BreadcrumbEllipsis(label="More", **attrs):
    <span data-part="ellipsis" role="img" aria-label={label} {**attrs}>…</span>


# ------------------------------------------------------------------ pagination

def Pagination(page=1, pages=1, href=None, onchange=None, siblings=1, label="Pagination", **attrs):
    """Links (`href="?page="` gets the number added) or buttons that call `onchange(n)`."""
    def go(n):
        if onchange and 1 <= n <= pages:
            onchange(n)
    <nav class="pw-pagination" data-part="pagination" aria-label={label} {**attrs}>
        <ul data-part="list">
            <li>
                if href:
                    <a class="pw-button" data-variant="ghost" data-part="previous" href={href + str(page - 1) if page > 1 else None}
                       aria-disabled={"true" if page <= 1 else None} aria-label="Previous page">‹ Previous</a>
                else:
                    <button type="button" class="pw-button" data-variant="ghost" data-part="previous" disabled={page <= 1}
                            aria-label="Previous page" onclick={lambda: go(page - 1)}>‹ Previous</button>
            </li>
            for n in _page_list(page, pages, siblings):
                <li>
                    if n == 0:
                        <span data-part="ellipsis" aria-hidden="true">…</span>
                    elif href:
                        <a class="pw-button" data-variant={"outline" if n == page else "ghost"} data-size="icon" data-part="page"
                           href={href + str(n)} aria-current={"page" if n == page else None}>{n}</a>
                    else:
                        <button type="button" class="pw-button" data-variant={"outline" if n == page else "ghost"} data-size="icon"
                                data-part="page" aria-current={"page" if n == page else None}
                                onclick={lambda n=n: go(n)}>{n}</button>
                </li>
            <li>
                if href:
                    <a class="pw-button" data-variant="ghost" data-part="next" href={href + str(page + 1) if page < pages else None}
                       aria-disabled={"true" if page >= pages else None} aria-label="Next page">Next ›</a>
                else:
                    <button type="button" class="pw-button" data-variant="ghost" data-part="next" disabled={page >= pages}
                            aria-label="Next page" onclick={lambda: go(page + 1)}>Next ›</button>
            </li>
        </ul>
    </nav>
